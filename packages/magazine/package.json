{
  "name": "@xpomag/magazine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./src/renderer.tsx",
      "import": "./dist/renderer.js",
      "default": "./dist/renderer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "19.2.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@xpomag/eslint-config": "workspace:*",
    "@xpomag/typescript-config": "workspace:*",
    "@types/react": "19.2.18",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
