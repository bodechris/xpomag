{
  "name": "@xpomag/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "xpomag-dev": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "xpomag-dev": "./src/schema.ts",
      "types": "./src/schema.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./schema/auth": {
      "xpomag-dev": "./src/schema/auth.ts",
      "types": "./src/schema/auth.ts",
      "import": "./dist/schema/auth.js",
      "default": "./dist/schema/auth.js"
    },
    "./schema/onboarding": {
      "xpomag-dev": "./src/schema/onboarding.ts",
      "types": "./src/schema/onboarding.ts",
      "import": "./dist/schema/onboarding.js",
      "default": "./dist/schema/onboarding.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@xpomag/magazine": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@xpomag/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.4",
    "typescript": "7.0.2",
    "@types/node": "26.4.1"
  }
}
